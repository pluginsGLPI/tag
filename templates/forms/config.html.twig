{% extends "pages/setup/general/base_form.html.twig" %}
{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{% block config_fields %}
    <div class="hr-text">
        <span>{{ __('Tag Management', 'tag') }}</span>
    </div>

    {{ inputs.hidden('config_class', config_class) }}
    {{ inputs.hidden('config_context', config_context) }}

    {{ fields.dropdownArrayField(
        'tags_location',
        tags_location,
        {
            0: __('Top'),
            1: __('Bottom')
        },
        __('Tags location', 'tag')
    ) }}
{% endblock %}
